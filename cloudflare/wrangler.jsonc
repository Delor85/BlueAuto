{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blue-magic-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-07",
  "keep_vars": true,
  "secrets": {
    "required": ["PAIRING_SECRET"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blue-magic",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": ""
  }
}
