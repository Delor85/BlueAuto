<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the historical manifest untouched while forcing legacy Android 6 launchers to consume
     a real density-specific PNG instead of a vector launcher drawable. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:antialias="true"
    android:dither="true"
    android:filter="true"
    android:gravity="fill"
    android:src="@mipmap/ic_launcher_bir" />
